  "html": "<section class=\"section\" id=\"programs\">\n  <div class=\"wrap\">\n    <div class=\"head center rv in\">\n      <div class=\"kicker\">What we teach &amp; what you will get</div>\n      <h1>Learning Programs</h1>\n      <p>Explore four learning programs, from understanding AI to designing production systems. Each program brings together an e-book and a corresponding Udemy course. The academy is being developed, with draft reading material available now.</p>\n    </div>\n\n    \n\n    \n\n    <div class=\"journey\" id=\"learning-programs\">\n\n      <a class=\"stop rv in\" href=\"/programs/ai-fundamentals\" aria-label=\"AI Fundamentals — learn more\">\n        <div class=\"thumb\">\n          <span class=\"ribbon\">Course coming soon</span>\n          <div class=\"gear\"><img src=\"/assets/oa-logo-trimmed.png\" alt=\"\"></div>\n        </div>\n        <div class=\"stopbody\">\n          <h3>AI Fundamentals</h3>\n          <p class=\"sfor\">What AI is, how it works conceptually, and how the landscape fits together. No math, no code.</p>\n          <div class=\"cardfoot\">\n            <span class=\"cta-dark\">Explore the program →</span>\n          </div>\n        </div>\n      </a>\n\n      <a class=\"stop rv in\" href=\"/programs/ai-associate\" aria-label=\"AI Associate — learn more\">\n        <div class=\"thumb\">\n          <span class=\"ribbon\">Course coming soon</span>\n          <div class=\"gear\"><img src=\"/assets/oa-logo-trimmed.png\" alt=\"\"></div>\n        </div>\n        <div class=\"stopbody\">\n          <h3>AI Associate</h3>\n          <p class=\"sfor\">Everyday professional AI skills — prompting, evaluating output, integrating AI into real work. No coding needed.</p>\n          <div class=\"cardfoot\">\n            <span class=\"cta-dark\">Explore the program →</span>\n          </div>\n        </div>\n      </a>\n\n      <a class=\"stop rv in\" href=\"/programs/ai-developer\" aria-label=\"AI Developer — learn more\">\n        <div class=\"thumb\">\n          <span class=\"ribbon\">Course coming soon</span>\n          <div class=\"gear\"><img src=\"/assets/oa-logo-trimmed.png\" alt=\"\"></div>\n        </div>\n        <div class=\"stopbody\">\n          <h3>AI Developer</h3>\n          <p class=\"sfor\">Integrating AI into real applications through code, tools, and APIs.</p>\n          <div class=\"cardfoot\">\n            <span class=\"cta-dark\">Explore the program →</span>\n          </div>\n        </div>\n      </a>\n\n      <a class=\"stop rv in\" href=\"/programs/ai-architect\" aria-label=\"AI Architect — learn more\">\n        <div class=\"thumb\">\n          <span class=\"ribbon\">Course coming soon</span>\n          <div class=\"gear\"><img src=\"/assets/oa-logo-trimmed.png\" alt=\"\"></div>\n        </div>\n        <div class=\"stopbody\">\n          <h3>AI Architect</h3>\n          <p class=\"sfor\">Designing full AI systems for production use, across two levels.</p>\n          <div class=\"cardfoot\">\n            <span class=\"cta-dark\">Explore the program →</span>\n          </div>\n        </div>\n      </a>\n\n    </div>\n  </div>\n</section>",
